      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n\nconst texto = (valor) =>\n  typeof valor === 'string' ? valor.trim() : '';\n\nconst errores = [];\n\nif (item.property_estado !== 'Aprobado') {\n  errores.push('El contenido ya no está aprobado');\n}\n\nif (!texto(item.property_asunto_aprobado)) {\n  errores.push('Falta el asunto aprobado');\n}\n\nif (!texto(item.property_contenido_aprobado)) {\n  errores.push('Falta el contenido aprobado');\n}\n\nif (!item.property_fecha_aprobacion?.start) {\n  errores.push('Falta la fecha de aprobación');\n}\n\nconst aprobadores = item.property_aprobado_por;\n\nif (\n  Array.isArray(aprobadores)\n    ? aprobadores.length === 0\n    : !aprobadores\n) {\n  errores.push('Falta el responsable de aprobación');\n}\n\nif (Number(item.property_version) !== 1) {\n  errores.push('La versión no coincide con la versión validada');\n}\n\nif (texto(item.property_id_envio)) {\n  errores.push('El contenido ya registra un envío');\n}\n\nif (\n  texto(item.property_email_destinatario).toLowerCase() !==\n  'elandle@hotmail.com'\n) {\n  errores.push('El destinatario no está autorizado');\n}\n\nreturn {\n  json: {\n    ...item,\n    validacion_final: {\n      es_valida: errores.length === 0,\n      errores\n    }\n  }\n};"
