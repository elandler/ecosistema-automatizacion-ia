    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n\nconst texto = (valor) =>\n  typeof valor === 'string' ? valor.trim() : '';\n\nconst errores = [];\n\nconst estado = texto(item.property_estado);\nconst asunto = texto(item.property_asunto_aprobado);\nconst contenido = texto(item.property_contenido_aprobado);\nconst email = texto(item.property_email_destinatario);\nconst idEnvio = texto(item.property_id_envio);\n\nconst version = Number(item.property_version);\nconst fechaAprobacion = item.property_fecha_aprobacion?.start;\n\nconst aprobadoPor = item.property_aprobado_por;\n\nconst tieneAprobador =\n  Array.isArray(aprobadoPor)\n    ? aprobadoPor.length > 0\n    : Boolean(aprobadoPor);\n\nif (estado !== 'Aprobado') {\n  errores.push('El contenido no está aprobado');\n}\n\nif (!asunto) {\n  errores.push('Falta el asunto aprobado');\n}\n\nif (!contenido) {\n  errores.push('Falta el contenido aprobado');\n}\n\nif (!Number.isInteger(version) || version < 1) {\n  errores.push('La versión no es válida');\n}\n\nif (!fechaAprobacion) {\n  errores.push('Falta la fecha de aprobación');\n}\n\nif (!tieneAprobador) {\n  errores.push('Falta identificar al responsable de la aprobación');\n}\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  errores.push('El correo del destinatario no es válido');\n}\n\nif (idEnvio) {\n  errores.push('El contenido ya tiene un identificador de envío');\n}\n\nreturn {\n  json: {\n    ...item,\n    validacion_aprobacion: {\n      es_valida: errores.length === 0,\n      errores,\n      version_validada: version\n    }\n  }\n};"
      },
